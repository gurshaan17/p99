# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron secret for Vercel cron jobs
CRON_SECRET=

# AWS SES (for sending email)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# Shared secret checked by the SNS webhook route. Generate your own, e.g.:
#   openssl rand -hex 32
# then set the same value as a query param on the SNS subscription URL.
SNS_WEBHOOK_SECRET=

# HMAC key that signs per-recipient unsubscribe links. Separate from
# CRON_SECRET so rotating the cron secret does not invalidate links in
# old inboxes. Generate one:
#   openssl rand -hex 32
UNSUBSCRIBE_SECRET=
